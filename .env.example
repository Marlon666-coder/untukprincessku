# Copy to `.env` and fill in your Supabase project values.
# Only PUBLIC values belong here — everything prefixed with VITE_ ends up in the browser bundle.
# NEVER put the Supabase service_role key or any secret here.

VITE_SUPABASE_URL=ISI_PROJECT_URL
VITE_SUPABASE_PUBLISHABLE_KEY=ISI_PUBLISHABLE_KEY

# Legacy fallback (older projects). Prefer VITE_SUPABASE_PUBLISHABLE_KEY above.
# VITE_SUPABASE_ANON_KEY=

# Optional, browser-restricted key (HTTP referrer limited) for an embedded map later.
# Without it the app falls back to plain Google Maps URLs.
VITE_GOOGLE_MAPS_BROWSER_KEY=
